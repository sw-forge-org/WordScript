{
  "name": "wordscript-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "wordscript.dev, the WordScript product site. Astro, static output, Cloudflare Workers static assets.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "prebuild": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "launch-check": "node scripts/launch-check.mjs",
    "build:ci": "npm run build && npm run launch-check",
    "deploy": "npm run build:ci && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.2.7",
    "lenis": "^1.3.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bootstrap-icons": "^1.13.1",
    "circle-flags": "^2.8.3",
    "simple-icons": "^16.28.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.126.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260825.1": true
  }
}
