{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The name matches the Worker that already exists in the dashboard. It was
  // `wordscript-dev` here and `wordscript-homepage` there, and Cloudflare said
  // so on the build page rather than failing: a mismatched name does not error,
  // it deploys a second Worker beside the first.
  "name": "wordscript-homepage",
  "compatibility_date": "2026-08-26",

  // THE SECOND PUBLIC HOSTNAME, CLOSED AT THE SOURCE.
  //
  // A Worker is reachable at `<name>.<subdomain>.workers.dev` unless this is
  // turned off, and `workers_dev` defaults to true -- checked against the
  // schema wrangler ships rather than assumed. That host is public and
  // indexable, so the site would stand in the index twice, the second time
  // under a URL nobody should ever be sent to.
  //
  // It is closed here rather than with an `X-Robots-Tag` in `_headers`,
  // because a header only asks a crawler not to list a page that is still
  // being served, and because that rule cannot even be written: `_headers`
  // allows exactly one `*` per rule, so `https://*.workers.dev/*` is invalid
  // and the account's own subdomain would have to be spelled in by hand.
  // Not existing beats not being listed.
  //
  // `preview_urls` is the same hazard one version deeper --
  // `<version>-<name>.<subdomain>.workers.dev`, created by
  // `wrangler versions upload`. It already defaults to false; it is written
  // out because a default is a thing that can change, and this one is a
  // posture rather than a preference.
  "workers_dev": false,
  "preview_urls": false,

  // THE CUSTOM DOMAIN IS LIVE. This line was commented out for the whole build
  // of this site and its comment called itself the launch gate. The owner
  // opened it on 2026-08-27 (ADR 0260).
  //
  // WHAT THIS LINE DOES, so nobody has to rediscover it: deploying with it
  // present does not merely configure a route. `custom_domain: true` makes
  // wrangler create the DNS record for `wordscript.dev`, and the site is public
  // from that second. Commenting it out again does NOT take the site down --
  // the record it created stays in the zone. Going back means deleting the
  // custom domain in the dashboard, or the record.
  //
  // WHAT WAS OPEN WHEN IT WAS OPENED, because a launch gate that is walked past
  // silently is worse than one that was never written. The imprint has no
  // second contact channel: section 5 DDG asks for a further means permitting
  // rapid and direct communication, and the Court of Justice read that same
  // wording in C-298/07 of 16 October 2008 as not satisfied by the address
  // alone. `PHONE` in `src/lib/legal.ts` is still `null`. The owner decided to
  // publish and supply the number afterwards; `scripts/launch-check.mjs` prints
  // it on every run instead of blocking. Three further gates have no artefact
  // in this repository and are unchanged: the Cloudflare Web Analytics switch
  // the privacy notice already names, a legal review of the three pages, and
  // the manual accessibility pass. `PRODUCT.md` under Open facts is the list.
  "routes": [{ "pattern": "wordscript.dev", "custom_domain": true }],

  // THE BUILD COMMAND IN THE DASHBOARD IS `npm run build:ci`, NOT `npm run build`.
  //
  // Workers Builds runs a build command and a deploy command as two steps, and
  // the obvious pair -- `npm run build` then `npx wrangler deploy` -- drops the
  // launch gate on the floor. `scripts/launch-check.mjs` hangs off
  // `npm run deploy`, which neither of those two calls. Everything it guards
  // against (an unfilled placeholder, a repealed statute, a dead
  // dispute-resolution link, the banned punctuation) would stop being checked
  // on the only path that publishes. `build:ci` is the build followed by the
  // gate, so a blocker fails the build. ADR 0259.

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
